"""Smoke test for scripts archetype."""

import runpy
from pathlib import Path


def test_hello_script_runs() -> None:
    script = Path(__file__).resolve().parents[1] / "scripts" / "hello.py"
    assert script.is_file()
    # Execute module-level main path without requiring package import.
    ns = runpy.run_path(str(script))
    assert callable(ns.get("main"))
